{
  "name": "vibevibe-raid-notifier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram Raidar topic watcher with persistent deduplication and X notifications",
  "engines": { "node": ">=24.13.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.js",
    "test": "node --test",
    "check": "node --env-file-if-exists=.env src/main.js --check",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.js",
    "x-account": "node --env-file-if-exists=.env scripts/x-account.js",
    "demo": "node scripts/demo.js"
  },
  "dependencies": {
    "oauth-1.0a": "2.2.6",
    "twitter-text": "3.1.0"
  }
}
