# Create a bot using @BotFather. Enable Bot-to-Bot Communication Mode.
# Add it to @vibevibefun and make it admin OR disable Group Privacy.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ID of the sole owner, never a username.
OWNER_TELEGRAM_ID=
# Use /where in the raid topic (as owner), replying to a Raidar message.
TELEGRAM_CHAT_ID=
# Blank for a normal group WITHOUT topics. Required for a forum/raid topic.
# Blank never means all topics.
TELEGRAM_TOPIC_ID=
RAIDAR_BOT_ID=

# Keep true while confirming real Raidar messages; no X credentials needed.
DRY_RUN=true
# manual: initially OFF; owner ON/OFF choice is saved across restarts.
# always: watches automatically. Saved /mode choices override this fallback.
WATCH_MODE=manual
# Compose overrides this with /app/data/raid-notifier.sqlite inside the container.
# Railway: set DATABASE_PATH=/app/data/raid-notifier.sqlite in service Variables
# and attach a persistent volume at /app/data; do not upload .env to GitHub.
DATABASE_PATH=./data/raid-notifier.sqlite
# Maximum delivery age within the CURRENT running session (seconds).
# Raids from before startup and pending work from previous sessions always skip.
MAX_EVENT_AGE_SECONDS=300

# Credit safeguards: all X requests are reserved in SQLite BEFORE sending.
# Counts include failures and account lookups. A restart never resets them.
# Defaults also apply to existing .env files that omit these keys.
X_MAX_REQUESTS_TOTAL=10000
X_MAX_REQUESTS_24H=120
X_MAX_POSTS_24H=100
X_MIN_POST_INTERVAL_SECONDS=0
# Lifetime cap never renews automatically. Raise it locally to approve more usage.

# Matches the supplied screenshots: "Raid Started!" starts, "Raid Tweet" refreshes.
# Regex source only, no / delimiters; case-insensitive, FIRST nonempty line only.
RAID_START_PATTERN='^[\s\p{Emoji_Presentation}\uFE0F\u200D]*Raid[ \t]+Started[ \t]*!?[ \t]*$'
RAID_END_PATTERN='\b(?:raid\s+(?:(?:is|has)\s+)?(?:completed?|finished|ended|stopped|cancelled|canceled)|(?:completed?|finished|ended|stopped|cancelled|canceled)\s+raid)\b'
# Optional: FIRST capture group must identify a stable, unique raid RUN.
# Example only: RAID_ID_PATTERN='Raid ID:\s*([A-Za-z0-9_-]+)'
# Without this, one notification per explicit "Raid Started!" message ID.
RAID_ID_PATTERN=

# OAuth 1.0a user credentials for your chosen X account, app Read and Write.
# Required when DRY_RUN=false. Never paste these into Telegram or commit them.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Numeric ID of the intended posting account; startup verifies /2/users/me.
X_EXPECTED_USER_ID=
